# Optional overrides for the confirmed public contacts in src/data.ts.
# Empty values use info@yuanenbag.com and +86 189 6971 7999.
# These values appear in the browser. Never put passwords here.
VITE_CONTACT_EMAIL=
VITE_WHATSAPP=

# Set to /yuanenbag/ when building for GitHub project Pages; otherwise leave /.
SITE_BASE_PATH=/

# Local builds default to noindex. Vercel Production uses true; previews are always noindex.
SITE_INDEXABLE=false

# Optional public GA4 override. Production defaults to G-TEESSYWLKE when unset.
# Explicitly empty disables analytics. Preview and localhost never load it.
SITE_GA4_MEASUREMENT_ID=

# Server-only enquiry mail. Never prefix these with VITE_.
# Configure in Vercel Production after validating SMTP access.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=info@yuanenbag.com
SMTP_PASS=
ENQUIRY_TO=info@yuanenbag.com
